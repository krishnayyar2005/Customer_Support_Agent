# Azure AI Foundry project endpoint
# Format: https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_AI_PROJECT_ENDPOINT=

# Agent name as registered in the Foundry portal
FOUNDRY_AGENT_NAME=Customer-Support-Agent

# Model deployment name used by the agent
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-5-mini

# Auth: DefaultAzureCredential is used by default.
# If using a service principal, set these:
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
#
# If using Azure CLI login, just run `az login` before starting the server.
